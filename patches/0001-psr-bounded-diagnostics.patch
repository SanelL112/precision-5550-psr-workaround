+/* Temporary, opt-in diagnostics: no PSR policy or register writes changed. */
+static bool psr_diag_enabled(struct intel_dp *intel_dp)
+{
+	struct intel_display *display = to_intel_display(intel_dp);
+
+	return display->params.psr_diag && DISPLAY_VER(display) == 9 &&
+		intel_dp_is_edp(intel_dp) && !intel_dp->psr.sel_update_enabled &&
+		!intel_dp->psr.panel_replay_enabled;
+}
+
+static bool psr_diag_take_log(struct intel_dp *intel_dp)
+{
+	static atomic_t remaining = ATOMIC_INIT(96);
+
+	return psr_diag_enabled(intel_dp) &&
+		atomic_dec_if_positive(&remaining) >= 0;
+}
+
+static void psr_diag_source(struct intel_dp *intel_dp, const char *event)
+{
+	struct intel_display *display = to_intel_display(intel_dp);
+	enum transcoder transcoder = intel_dp->psr.transcoder;
+	static struct ratelimit_state source_rate =
+		RATELIMIT_STATE_INIT_FLAGS(source_rate, 5 * HZ, 2,
+					   RATELIMIT_MSG_ON_RELEASE);
+
+	/* Keep source logging available across the login transition. */
+	if (!psr_diag_enabled(intel_dp) || !__ratelimit(&source_rate) ||
+	    !psr_diag_take_log(intel_dp))
+		return;
+
+	lockdep_assert_held(&intel_dp->psr.lock);
+	drm_info(display->drm,
+		 "PSRDIAG-v1 %s enabled=%d active=%d standby=%d busy=%#x ctl=%#010x status=%#010x debug=%#010x perf=%u\n",
+		 event, intel_dp->psr.enabled, intel_dp->psr.active,
+		 intel_dp->psr.link_standby, intel_dp->psr.busy_frontbuffer_bits,
+		 intel_de_read(display, psr_ctl_reg(display, transcoder)),
+		 intel_de_read(display, psr_status_reg(display, transcoder)),
+		 intel_de_read(display, psr_debug_reg(display, transcoder)),
+		 intel_de_read(display, psr_perf_cnt_reg(display, transcoder)));
 }
 
